      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.24 < 9.0.0"
    },
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "pdk-version": "3.4.0",
  "template-url": "pdk-default#3.4.0",
  "template-ref": "tags/3.4.0-0-gd3cc13f"

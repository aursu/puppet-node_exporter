{
  "name": "aursu-node_exporter",
  "version": "0.1.0",
  "author": "aursu",
  "summary": "Install Prometheus node_exporter from a checksum-verified release, with a textfile collector",
  "license": "Apache-2.0",
  "source": "https://github.com/aursu/puppet-node_exporter",
  "project_page": "https://github.com/aursu/puppet-node_exporter",
  "issues_url": "https://github.com/aursu/puppet-node_exporter/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppet/archive",
      "version_requirement": ">= 7.1.0 < 10.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 7.1.0 < 12.0.0"
    }
  ],
  "operatingsystem_support": [
    {
